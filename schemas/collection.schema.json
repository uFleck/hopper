{
  "$defs": {
    "ApiKeyIn": {
      "enum": [
        "header",
        "query"
      ],
      "type": "string"
    },
    "Auth": {
      "description": "Values are variable references (`{{apiKey}}`), never secrets themselves.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "inherit",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "token": {
              "type": "string"
            },
            "type": {
              "const": "bearer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "token"
          ],
          "type": "object"
        },
        {
          "properties": {
            "password": {
              "type": "string"
            },
            "type": {
              "const": "basic",
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "username",
            "password"
          ],
          "type": "object"
        },
        {
          "properties": {
            "in": {
              "$ref": "#/$defs/ApiKeyIn"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "const": "apiKey",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "value",
            "in"
          ],
          "type": "object"
        }
      ]
    },
    "DocKind": {
      "enum": [
        "workspace",
        "collection",
        "folder",
        "request",
        "environment"
      ],
      "type": "string"
    },
    "KeyValue": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "SpecLink": {
      "properties": {
        "docHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "importedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "description": "May contain `{{variables}}`, resolved with the active environment.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "auth": {
      "$ref": "#/$defs/Auth"
    },
    "headers": {
      "items": {
        "$ref": "#/$defs/KeyValue"
      },
      "type": "array"
    },
    "hopper": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/DocKind"
    },
    "name": {
      "type": "string"
    },
    "specs": {
      "items": {
        "$ref": "#/$defs/SpecLink"
      },
      "type": "array"
    },
    "variables": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "hopper",
    "kind",
    "name"
  ],
  "title": "Collection",
  "type": "object"
}
