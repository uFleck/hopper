{
  "$defs": {
    "ApiKeyIn": {
      "enum": [
        "header",
        "query"
      ],
      "type": "string"
    },
    "Auth": {
      "description": "Values are variable references (`{{apiKey}}`), never secrets themselves.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "inherit",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "token": {
              "type": "string"
            },
            "type": {
              "const": "bearer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "token"
          ],
          "type": "object"
        },
        {
          "properties": {
            "password": {
              "type": "string"
            },
            "type": {
              "const": "basic",
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "username",
            "password"
          ],
          "type": "object"
        },
        {
          "properties": {
            "in": {
              "$ref": "#/$defs/ApiKeyIn"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "const": "apiKey",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "value",
            "in"
          ],
          "type": "object"
        }
      ]
    },
    "Body": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "const": "json",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "const": "xml",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "fields": {
              "items": {
                "$ref": "#/$defs/KeyValue"
              },
              "type": "array"
            },
            "type": {
              "const": "form",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "type": "object"
        },
        {
          "properties": {
            "parts": {
              "items": {
                "$ref": "#/$defs/MultipartPart"
              },
              "type": "array"
            },
            "type": {
              "const": "multipart",
              "type": "string"
            }
          },
          "required": [
            "type",
            "parts"
          ],
          "type": "object"
        },
        {
          "properties": {
            "file": {
              "type": "string"
            },
            "type": {
              "const": "binary",
              "type": "string"
            }
          },
          "required": [
            "type",
            "file"
          ],
          "type": "object"
        }
      ]
    },
    "DocKind": {
      "enum": [
        "workspace",
        "collection",
        "folder",
        "request",
        "environment"
      ],
      "type": "string"
    },
    "KeyValue": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ],
      "type": "string"
    },
    "MultipartPart": {
      "anyOf": [
        {
          "properties": {
            "value": {
              "type": "string"
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Source": {
      "properties": {
        "hash": {
          "type": "string"
        },
        "key": {
          "description": "`operationId`, else `METHOD /path/{param}`.",
          "type": "string"
        },
        "orphaned": {
          "type": "boolean"
        },
        "spec": {
          "type": "string"
        }
      },
      "required": [
        "spec",
        "key",
        "hash"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "auth": {
      "$ref": "#/$defs/Auth",
      "default": {
        "type": "inherit"
      }
    },
    "body": {
      "$ref": "#/$defs/Body",
      "default": {
        "type": "none"
      }
    },
    "followRedirects": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "headers": {
      "items": {
        "$ref": "#/$defs/KeyValue"
      },
      "type": "array"
    },
    "hopper": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "description": "Stable ULID; requests are referenced by id, never by path.",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/DocKind"
    },
    "method": {
      "$ref": "#/$defs/Method"
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "pathParams": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "query": {
      "items": {
        "$ref": "#/$defs/KeyValue"
      },
      "type": "array"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeoutMs": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "url": {
      "description": "`{{var}}` is a Hopper variable, `{param}` an OpenAPI path parameter.",
      "type": "string"
    },
    "variables": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "hopper",
    "kind",
    "id",
    "name",
    "method",
    "url"
  ],
  "title": "Request",
  "type": "object"
}
